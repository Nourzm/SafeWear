# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase client config files are committed: they contain public client
# identifiers (shipped in every app binary), not secrets. Access control
# lives in Firestore security rules.

# ─── Android signing ──────────────────────────────────────
android/key.properties
**/*.keystore
**/*.jks

# ─── iOS Pods ─────────────────────────────────────────────
**/ios/Pods/
**/ios/.symlinks/

# ─── Node (Firebase Functions) ────────────────────────────
functions/node_modules/
functions/lib/
functions/.runtimeconfig.json

# ─── Secrets / env ────────────────────────────────────────
.env
.env.*
secrets.json

# ─── Build reports / artifacts ────────────────────────────
android/build/
**/build/reports/

# ─── Windows OS ───────────────────────────────────────────
Thumbs.db
desktop.ini
